# Nginx 站点配置示例
# 放到服务器: /etc/nginx/conf.d/gator.conf  （CentOS）或
#            /etc/nginx/sites-available/gator + 软链到 sites-enabled（Ubuntu/Debian）
#
# server_name 换成你的域名；没有域名就填服务器 IP 或 _

server {
    listen 80;
    server_name gator.example.com;
    root /var/www/gator;
    index index.html;
    charset utf-8;

    # 摊平的 404 页
    error_page 404 /404.html;

    # 静态资源长缓存
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public";
    }
    location /images/ {
        expires 30d;
        add_header Cache-Control "public";
    }

    # HTML 每次协商缓存，更新即时生效
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
    }

    # gzip：搜索索引 3.8MB 压缩后约 1MB，体验差别很大
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1k;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;
}

# HTTPS 配好后 certbot 会自动改写这个文件；
# 也可以手动启用:
# server {
#     listen 443 ssl http2;
#     server_name gator.example.com;
#     root /var/www/gator;
#     index index.html;
#     ssl_certificate     /etc/letsencrypt/live/gator.example.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/gator.example.com/privkey.pem;
#     # ……其余 location 同上
# }
